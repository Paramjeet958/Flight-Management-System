<!DOCTYPE html>
<html lang="en">
    <%- include('layouts/header'); -%>
<head>
    <link href="/css/allflights.css" type="text/css" rel="stylesheet"> 
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet"> 

<style>
    .card {
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.card-title {
    font-weight: bold;
    color: #007bff;
}
</style>
</head>
<body>
    <%- include('layouts/navbar'); -%>
   
    <div class="container mt-5">
        <h1 class="mb-4">All Users</h1>
        <div class="row">
            <% users.forEach((user) => { %>
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><%= user.fname %> <%= user.lname %></h5>
                            <p class="card-text"><strong>Username:</strong> <%= user.userName %></p>
                            <p class="card-text"><strong>Email:</strong> <%= user.email %></p>
                            <p class="card-text"><strong>Phone:</strong> <%= user.phone %></p>
                            <p class="card-text"><strong>Address:</strong> <%= user.street %>, <%= user.city %>, <%= user.state %>, <%= user.zip %>, <%= user.country %></p>
                            <p class="card-text"><strong>Date of Birth:</strong> <%= new Date(user.dateOfBirth).toLocaleDateString() %></p>
                            <p class="card-text"><strong>Passport Number:</strong> <%= user.passportNumber %></p>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <%- include('layouts/footer'); -%>
    <%- include('layouts/scripts'); -%>
  
</body>
</html>
