<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layouts/header'); -%>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <title>My Account</title>
    <STYLE>
        .table-responsive {
    display: flex;
    justify-content: center;
}

.table {
    width: 100%;
    table-layout: fixed;
}

.table th, .table td {
    white-space: wrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
tbody tr:hover {
            font-weight: bold;
            background-color: #bcbbbb; /* Light grey background on hover */
        }

    </STYLE>
</head>
<body>
    <%- include('layouts/navbar'); -%>
    <div class="container mt-5">
        <div class="card">
            <div class="card-header bg-success text-white text-center">
                <h2>My Account</h2>
            </div>
           
            <div class="card-body">
                <h3>User Information</h3>
                <ul class="list-group mb-4">
                    <li class="list-group-item"><strong>Username:</strong> <%= user.userName %></li>
                    <li class="list-group-item"><strong>Email:</strong> <%= user.email %></li>
                    <li class="list-group-item"><strong>First Name:</strong> <%= user.fname %></li>
                    <li class="list-group-item"><strong>Last Name:</strong> <%= user.lname %></li>
                    <li class="list-group-item"><strong>Phone:</strong> <%= user.phone %></li>
                    <li class="list-group-item"><strong>Street:</strong> <%= user.street %></li>
                    <li class="list-group-item"><strong>City:</strong> <%= user.city %></li>
                    <li class="list-group-item"><strong>State:</strong> <%= user.state %></li>
                    <li class="list-group-item"><strong>Zip:</strong> <%= user.zip %></li>
                    <li class="list-group-item"><strong>Country:</strong> <%= user.country %></li>
                    <li class="list-group-item"><strong>Date of Birth:</strong> <%= user.dateOfBirth %></li>
                    <li class="list-group-item"><strong>Passport Number:</strong> <%= user.passportNumber %></li>
                </ul>
                <a href="/updateUserPage" class="btn btn-warning">UPDATE PROFILE</a>
                <br><br>
                <h3>Your Bookings</h3>
                <% if (bookings && bookings.length>0) { %> 
                    <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Booking ID</th>
                                    <th>Flight Number</th>
                                    <th>Flight Name</th>
                                    <th>Departure</th>
                                    <th>Arrival</th>
                                    <th>Seat Number</th>
                                    <th>Status</th>
                                    <th>Update</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bookings.forEach(booking => { %>
                                    <tr>
                                        <td><%= booking._id %></td>
                                        <td><%= booking.flightNumber %></td>
                                        <td><%= booking.flightName %></td>
                                        <td><%= new Date(booking.departureDate).toLocaleString() %></td>
                                        <td><%= new Date(booking.arrivalDate).toLocaleString() %></td>
                                        <td><%= booking.seatNumber %></td>
                                        <td><%= booking.status %></td>
                                        <td><a href="/updateUserBookingPage?<%= new URLSearchParams({
                                            booking_id: booking._id,
                                            flightNumber: booking.flightNumber,
                                            flightName: booking.flightName,
                                            seatNumber: booking.seatNumber,
                                            departureDate: booking.departureDate.toISOString(),
                                            arrivalDate: booking.arrivalDate.toISOString(),
                                            status: booking.status,
                                            price:booking.price,
                                            fullName: booking.fullName,
                                            email: booking.email,
                                            phone: booking.phone,
                                            address: booking.address

                                        }).toString() %>">Update</a></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                </div>
                </div>
                <% } else { %>
                    <p>No bookings found.</p>
                <% } %>
            </div>
        </div>
    </div>
    <%- include('layouts/footer'); -%>
    <%- include('layouts/scripts'); -%>
</body>
</html>
